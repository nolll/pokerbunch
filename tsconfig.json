{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "strict": true,
    "importHelpers": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "noImplicitAny": true
  },
  "typeRoots": ["./node_modules/@types"],
  "include": ["./js/*.ts", "./js/**/*.ts", "./js/*.vue", "./js/**/*.vue", "./global-shim.d.ts", "./js/types.d.ts"],
  "exclude": ["node_modules"],
  "lib": ["dom", "dom.iterable", "scripthost", "es2015"]
}
